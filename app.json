{
  "expo": {
    "name": "Nexway",
    "slug": "nexway",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.nexus.nexway",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Nexway use a c\u00e2mera para realidade aumentada.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "ios": {
            "cameraUsagePermission": "Permita que o Nexway use a c\u00e2mera para reconhecer estantes e indicar o destino."
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.nexus.nexway",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Permita que o Nexway use a c\u00e2mera para reconhecer estantes e indicar o destino.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "scheme": "nexway"
  }
}
