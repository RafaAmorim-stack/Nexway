{
  "name": "nexway",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform android",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "export:web": "expo export --platform web",
    "start:tunnel": "expo start --go --tunnel",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "expo": "~58.0.17",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4",
    "expo-camera": "~58.0.12",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/react": "~19.3.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  }
}
